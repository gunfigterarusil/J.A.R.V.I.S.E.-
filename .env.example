# Jarvis Brain / Cognitive Brain configuration
# Copy this file to .env and fill only the values you need.

# Local web dashboard
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000
BRAIN_RELOAD=false

# Optional: protect control endpoints with a bearer token.
# If empty, token checks are disabled for local development.
WEB_UI_API_TOKEN=
WEB_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Local Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud providers - never hardcode these in config.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# llama.cpp server
LLAMACPP_HOST=http://localhost:8080


# ---------------------------------------------------------------------------
# V10 Modular Model/API Router
# ---------------------------------------------------------------------------
# Profiles: offline, balanced, power, code, voice_companion, custom.
# Role overrides are optional; leave blank to use the selected profile.
MODEL_PROFILE=offline
MODEL_FAST_PROVIDER=
MODEL_FAST_NAME=
MODEL_REASON_PROVIDER=
MODEL_REASON_NAME=
MODEL_CODE_PROVIDER=
MODEL_CODE_NAME=
MODEL_CRITIC_PROVIDER=
MODEL_CRITIC_NAME=
MODEL_VISION_PROVIDER=
MODEL_VISION_NAME=
MODEL_EMBEDDING_PROVIDER=
MODEL_EMBEDDING_NAME=
MODEL_ACTION_PROVIDER=
MODEL_ACTION_NAME=
MODEL_HEALTH_CHECK_ENABLED=true
MODEL_FALLBACK_ENABLED=true
MODEL_STATUS_EMIT_ENABLED=true
MODEL_DEFAULT_TIMEOUT=60
MODEL_MAX_TOKENS=2048
MODEL_TEMPERATURE=0.7

# Example custom/offline coding setup:
# MODEL_PROFILE=custom
# MODEL_FAST_PROVIDER=ollama
# MODEL_FAST_NAME=qwen2.5:7b
# MODEL_REASON_PROVIDER=ollama
# MODEL_REASON_NAME=llama3.1:8b
# MODEL_CODE_PROVIDER=ollama
# MODEL_CODE_NAME=qwen2.5-coder:7b
# MODEL_ACTION_PROVIDER=ollama
# MODEL_ACTION_NAME=qwen2.5:7b

# ---------------------------------------------------------------------------
# Voice MVP: microphone -> faster-whisper -> brain -> Piper TTS
# ---------------------------------------------------------------------------
# Start with: python main.py --voice
VOICE_STT_MODEL=small
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
# Leave empty for auto-detect, or use uk/en/ru/etc.
VOICE_STT_LANGUAGE=
VOICE_RECORD_SECONDS=5
VOICE_ENERGY_THRESHOLD=0.005
# continuous = always record chunks; push_to_talk = press Enter before each utterance
VOICE_INPUT_MODE=continuous
VOICE_PUSH_TO_TALK_PROMPT=Press Enter to speak, or type q + Enter to quit: 
VOICE_RESPONSE_TIMEOUT=90
VOICE_TTS_WAIT_TIMEOUT=45
VOICE_LISTEN_AFTER_RESPONSE_DELAY=0.35
# Optional wake word. Example: Jarvis
VOICE_WAKE_WORD=
VOICE_INTERRUPT_PHRASES=stop,зупинись,стоп,замовкни,тихо
VOICE_MUTE_PHRASES=mute,мовчи,замовкни,не говори
VOICE_UNMUTE_PHRASES=unmute,говори,можеш говорити
VOICE_TTS_ENABLED=true
VOICE_START_MUTED=false
# auto = Piper first, pyttsx3 fallback. Options: auto, piper, pyttsx3, none
VOICE_TTS_BACKEND=auto
PIPER_EXECUTABLE=piper
# Required for voice output. Example:
# PIPER_MODEL_PATH=/home/user/piper/voices/en_US-lessac-medium.onnx
PIPER_MODEL_PATH=
PIPER_CONFIG_PATH=
PIPER_SPEAKER=
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8

# pyttsx3 fallback settings
PYTTSX3_VOICE_ID=
PYTTSX3_RATE=175
PYTTSX3_VOLUME=1.0

# Legacy fake audio simulator. Keep false when using real voice mode.
AUDIO_SIMULATION_ENABLED=false

# V3 Screen Reading MVP
SCREEN_READING_ENABLED=true
SCREEN_AUTO_WATCH_ENABLED=false
SCREENSHOT_DIR=
SCREEN_OCR_BACKEND=tesseract
# Use "eng", "ukr", "eng+ukr", etc. Install matching Tesseract language packs.
SCREEN_OCR_LANGUAGE=eng
SCREEN_OCR_CONFIG=--psm 6
SCREEN_SAVE_SCREENSHOTS=true
SCREEN_MAX_OCR_CHARS=7000
# Optional full path if tesseract is not in PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# V4 Emotions + Deep Monologue
EMOTION_V4_ENABLED=true
EMOTION_STATE_EMIT_INTERVAL=4.0
EMOTION_DECAY_STRENGTH=0.985
MONOLOGUE_V4_ENABLED=true
MONOLOGUE_INTERVAL=6.0

# ── V5 self/world model ─────────────────────────────────────
SELF_MODEL_V5_ENABLED=true
SELF_MODEL_SNAPSHOT_INTERVAL=12.0
SELF_MODEL_REFLECTION_INTERVAL=45.0
WORLD_MODEL_V5_ENABLED=true
WORLD_MODEL_SNAPSHOT_INTERVAL=10.0
WORLD_MODEL_MAX_TIMELINE_ITEMS=80
WORLD_MODEL_MAX_OPEN_LOOPS=25

# V6 Sleep / Dream Replay / Memory Consolidation
SLEEP_V6_ENABLED=true
SLEEP_AUTO_ENABLED=true
SLEEP_AUTO_INTERVAL=900
SLEEP_IDLE_THRESHOLD=90
SLEEP_ENERGY_THRESHOLD=0.38
SLEEP_MANUAL_MIN_GAP=3.0
SLEEP_MAX_REPLAY_EVENTS=80
SLEEP_MAX_DIALOGUE_PAIRS=24
SLEEP_MAX_LESSONS_PER_CYCLE=8

# V7 — Safe PC automation / tier4_actions
ACTIONS_V7_ENABLED=true
ACTION_WORKSPACE_PATH=~/jarvis_workspace
ACTION_MAX_READ_CHARS=12000
ACTION_MAX_LIST_ENTRIES=120
# Shell is OFF by default. Enable only when you understand the risk.
ACTION_ALLOW_SHELL=false
ACTION_COMMAND_TIMEOUT=20
ACTION_ALLOWED_COMMANDS=python,python3,py,pytest,pip,pip3,git

# V8.1 — Desktop Settings + Natural Action Router
NATURAL_ACTIONS_ENABLED=true
NATURAL_ACTIONS_REQUIRE_EXPLICIT_VERB=true
REPAIR_AGENT_ENABLED=true

# V9 Project Repair Agent
CODE_REPAIR_V9_ENABLED=true
CODE_REPAIR_MAX_FILES=160
CODE_REPAIR_MAX_FILE_CHARS=18000
CODE_REPAIR_AUTO_APPLY=false
CODE_REPAIR_REQUIRE_LLM=true

# ---------------------------------------------------------------------------
# V9.1 Long-Term Memory + Portable Mode
# ---------------------------------------------------------------------------
# Set true if JAV is placed on a portable drive and should keep data beside app.
JAV_PORTABLE=false
# Brain/memory directory. If empty, defaults to ~/.jarvis_brain, or ./data/brain when JAV_PORTABLE=true.
JARVIS_DATA_DIR=
# Long-term memory policy. 730 days ≈ 2 years. Increase to 3650 for ~10 years.
MEMORY_STM_LIFETIME_SECONDS=30
MEMORY_EPISODIC_RETENTION_DAYS=730
MEMORY_EPISODIC_MAX_ITEMS=20000
MEMORY_ARCHIVE_DECAYED=true
MEMORY_SEMANTIC_AUTOSTORE=true
MEMORY_SAVE_INTERVAL_SECONDS=60
MEMORY_SQLITE_ENABLED=true
MEMORY_VECTOR_ENABLED=true
MEMORY_VECTOR_DIMENSIONS=256
MEMORY_SEARCH_TOP_K=8

# ---------------------------------------------------------------------------
# V9.3 Web Learning / Search
# ---------------------------------------------------------------------------
WEB_LEARNING_ENABLED=true
WEB_SEARCH_ENABLED=true
WEB_LEARN_STORE_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_LEARN_MAX_SOURCES=4
WEB_FETCH_TIMEOUT_SECONDS=12
WEB_FETCH_MAX_CHARS_PER_PAGE=9000
WEB_USER_AGENT=JAV-WebLearning/0.1

# V9.4 Autonomous / guided task chains
TASK_CHAINS_ENABLED=true
TASK_CHAINS_AUTO_STEP_DEFAULT=false
TASK_CHAINS_MAX_STEPS=8
TASK_CHAINS_STEP_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# V9.5 Runtime / Service Mode / Watchdog
# ---------------------------------------------------------------------------
# Interactive use keeps this false. The watchdog sets it true automatically.
JAV_SERVICE_MODE=false
# External watchdog helper can restart the service if it exits or heartbeat stalls.
JAV_WATCHDOG_ENABLED=true
RUNTIME_HEARTBEAT_INTERVAL_SECONDS=10
RUNTIME_HEARTBEAT_STALE_SECONDS=45
RUNTIME_HEALTH_CHECK_INTERVAL_SECONDS=30
RUNTIME_AUTO_SLEEP_ON_SHUTDOWN=true
RUNTIME_LOG_TO_FILE=true
# Leave empty to use <brain-data-dir>/logs.
RUNTIME_LOG_DIR=
RUNTIME_LOG_MAX_BYTES=2097152
RUNTIME_LOG_BACKUP_COUNT=5
# Leave empty to use <brain-data-dir>/runtime.pid and runtime_heartbeat.json.
RUNTIME_PID_FILE=
RUNTIME_HEARTBEAT_FILE=
RUNTIME_CRASH_REPORT_FILE=
WATCHDOG_MAX_RESTART_ATTEMPTS=20
WATCHDOG_RESTART_DELAY_SECONDS=5

# ---------------------------------------------------------------------------
# V9.6 Real Vision + GUI Understanding
# ---------------------------------------------------------------------------
# Understanding only: Jarvis analyzes the screen/UI and suggests steps, but does not click automatically.
SCREEN_VISION_ENABLED=true
SCREEN_GUI_UNDERSTANDING_ENABLED=true
SCREEN_ACTIVE_WINDOW_ENABLED=true
SCREEN_MAX_UI_ELEMENTS=40
SCREEN_MIN_UI_CONFIDENCE=35

# ---------------------------------------------------------------------------
# V9.7 Safe General GUI Automation
# ---------------------------------------------------------------------------
# Universal observe -> reason -> act -> observe GUI loop. Actions still pass through safety.
GUI_AUTOMATION_ENABLED=true
# Keep false by default. If true, /gui-auto and natural "самостійно" can continue multiple safe steps.
GUI_AUTOMATION_AUTO_ENABLED=false
GUI_AUTOMATION_MAX_STEPS=12
GUI_AUTOMATION_STEP_DELAY_SECONDS=1.0
GUI_AUTOMATION_REQUIRE_CONFIRMATION=true
GUI_AUTOMATION_BLOCK_SENSITIVE=true
GUI_AUTOMATION_VERIFY_AFTER_ACTION=true
GUI_AUTOMATION_SCREENSHOT_AUDIT=true
GUI_AUTOMATION_SEMANTIC_CLICK_THRESHOLD=35
GUI_AUTOMATION_MAX_RETRIES_PER_STEP=2
GUI_AUTOMATION_ALLOWED_ACTIONS=observe,done,open_url,open_app,click_xy,click_text,type_text,press,hotkey,scroll,wait

# ---------------------------------------------------------------------------
# V11 System Monitor
# ---------------------------------------------------------------------------
SYSTEM_MONITOR_ENABLED=true
SYSTEM_MONITOR_INTERVAL_SECONDS=20
SYSTEM_ALERT_COOLDOWN_SECONDS=300
SYSTEM_CPU_WARN_PERCENT=90
SYSTEM_MEMORY_WARN_PERCENT=88
SYSTEM_DISK_WARN_PERCENT=90
SYSTEM_TEMP_WARN_C=85
SYSTEM_CHECK_NETWORK=true
SYSTEM_CHECK_OLLAMA=true
SYSTEM_CHECK_MODELS=true
SYSTEM_NETWORK_TIMEOUT_SECONDS=3

# ---------------------------------------------------------------------------
# V11 Proactive Companion
# ---------------------------------------------------------------------------
PROACTIVE_COMPANION_ENABLED=true
PROACTIVE_CHAT_NOTIFICATIONS=true
# Keep false until you test it, otherwise alerts can speak through TTS.
PROACTIVE_SPEAK_NOTIFICATIONS=false
PROACTIVE_MIN_IMPORTANCE=0.55
PROACTIVE_COOLDOWN_SECONDS=300
PROACTIVE_NOTIFY_TASK_PROGRESS=true
PROACTIVE_DAILY_SUMMARY_ENABLED=true
PROACTIVE_DAILY_SUMMARY_INTERVAL_SECONDS=86400
PROACTIVE_DO_NOT_DISTURB=false
PROACTIVE_STARTUP_GRACE_SECONDS=15

# V13 Advanced Task Orchestrator
TASK_CHAINS_ENABLED=true
TASK_CHAINS_AUTO_STEP_DEFAULT=false
TASK_CHAINS_MAX_STEPS=12
TASK_CHAINS_STEP_TIMEOUT_SECONDS=120
TASK_CHAINS_MAX_RETRIES_PER_STEP=2
TASK_CHAINS_VERIFIER_ENABLED=true
TASK_CHAINS_ROLLBACK_ENABLED=true
TASK_CHAINS_STRATEGY_COUNT=3
TASK_CHAINS_AUTO_CONTINUE_AFTER_SAFE_STEP=true

# V14 Skill Learning + Knowledge Graph
SKILL_LEARNING_ENABLED=true
SKILL_AUTO_LEARN_ENABLED=true
SKILL_MIN_CONFIDENCE=0.55
SKILL_MAX_SKILLS=1000
KNOWLEDGE_GRAPH_MAX_EDGES=5000

# ---------------------------------------------------------------------------
# V15 Desktop Assistant Shell
# ---------------------------------------------------------------------------
DESKTOP_WINDOW_GEOMETRY=1320x820
DESKTOP_TRAY_ENABLED=true
DESKTOP_NOTIFICATIONS_ENABLED=true
DESKTOP_NOTIFICATION_COOLDOWN_SECONDS=20
DESKTOP_START_MINIMIZED=false
DESKTOP_ASSISTANT_SHELL_THEME=dark
DESKTOP_SHOW_EVENT_STREAM=true
DESKTOP_SHOW_APPROVAL_PANEL=true
# === V16 Model Setup Wizard notes ===
# Open desktop → Models → Setup Wizard, or run:
#   python main.py --model-doctor
# Supported MODEL_PROFILE values:
#   offline, low_ram, hybrid, cloud, code, voice_companion, custom
# Role providers: ollama, openai, gemini, anthropic, llamacpp, null
# Example missing-model install commands are shown by --model-doctor.


# V17.1 Ambient perception stability/privacy
SCREEN_AMBIENT_PRIVACY_MODE=true
SCREEN_AMBIENT_STORE_SCREENSHOTS=false
SCREEN_AMBIENT_PROACTIVE_COOLDOWN=120
SCREEN_AMBIENT_SAME_ERROR_COOLDOWN=300
SCREEN_AMBIENT_EXCLUDED_APPS=
SCREEN_AMBIENT_PAUSE_ON_SENSITIVE=true

# V17.1 Emotional TTS default is subtle; 0 disables, 1 is full effect
VOICE_EMOTIONAL_TTS=true
VOICE_EMOTIONAL_TTS_STRENGTH=0.35
