# JAV configuration
# Copy this file to .env and edit values.

# Portable mode: data paths become relative to the program folder.
JAV_PORTABLE=true
JARVIS_DATA_DIR=data/brain
ACTION_WORKSPACE_PATH=data/workspace
SCREENSHOT_DIR=data/screenshots

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
WEB_UI_API_TOKEN=

# Models / API keys
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLAMACPP_HOST=http://localhost:8080

# Safety
SAFETY_DEFAULT_LEVEL=1
